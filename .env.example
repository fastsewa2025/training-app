# FastSewa Training: every setting, in one place.
#
#   cp .env.example .env      then edit .env. Never commit it (it is in .gitignore).
#
# Format rules (so the same file works for docker compose, `docker run --env-file` and systemd):
#   * one KEY=value per line, no spaces around "=", no quotes needed, no trailing comments;
#   * a line that starts with # is a comment. Remove the # to switch an optional setting on.
#
# The API checks all of this when it starts. In production a missing or unsafe value stops it
# with a list of exactly what to fix, instead of running half-configured.

# ═════════════════════════════════════════════════════════════════════════════
# REQUIRED IN PRODUCTION
# ═════════════════════════════════════════════════════════════════════════════

# Public https address of the API, no trailing slash. It is printed into certificates (QR code,
# verification link) and used for download links, so it must be the real address workers can reach.
# The API refuses to start in production while this is a placeholder such as api.example.com or localhost.
PUBLIC_BASE_URL=https://api.example.com

# PostgreSQL connection string.
#   managed database (recommended):  postgresql://user:password@host:5432/dbname?sslmode=require
#   docker compose local-db profile: postgresql://fastsewa:<DB_PASSWORD>@db:5432/fastsewa
# Special characters in the password must be percent-encoded (for example @ becomes %40).
DATABASE_URL=postgresql://fastsewa:CHANGE_ME@db:5432/fastsewa

# Signs every login token. At least 32 random characters, never reused from another system.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origins allowed to call the API from a browser (the admin console is served by the API itself and
# needs no entry). Comma separated, no trailing slashes. Native mobile apps are not affected by CORS.
# Add the web build of the app here only if you publish one.
ALLOWED_ORIGINS=

# ═════════════════════════════════════════════════════════════════════════════
# SERVER
# ═════════════════════════════════════════════════════════════════════════════

# NODE_ENV is set to production by the Docker image and docker-compose.yml. Set it yourself only
# when you run the API without them.
# NODE_ENV=production

# PORT=5000
# HOST=0.0.0.0

# How many proxies sit in front of the API: 1 for nginx or a platform load balancer (the default in
# production), 2 for a CDN plus nginx, 0 when clients connect directly. "true" is refused: it would
# let clients forge their address and escape the rate limits.
# TRUST_PROXY=1

# fatal | error | warn | info | debug | trace | silent   (default info)
# LOG_LEVEL=info

# How many password hashes (sign-ins, password changes) may be computed at the same time; each takes about 100 ms of one
# CPU core. Default 3, minimum 2. Raise it only on a machine with many cores. More requests than 200 waiting get a
# "server busy" answer and the app retries.
# PASSWORD_HASH_CONCURRENCY=3

# Set to false to switch the admin console at /admin off (for example on a public-only API instance).
# ADMIN_CONSOLE_ENABLED=true

# Shown by /api/health and in the logs. Leave it unset: the build takes it from package.json. Set it only to override.
# APP_VERSION=

# ═════════════════════════════════════════════════════════════════════════════
# DATABASE
# ═════════════════════════════════════════════════════════════════════════════

# disable | require | verify. Default: disable for localhost/db, verify for any other host in production.
# "require" encrypts but does not check the server certificate; "verify" does (add DATABASE_SSL_CA for a
# private CA such as AWS RDS). Most managed providers (Neon, Supabase, Render, RDS) work with verify.
# DATABASE_SSL=verify
# DATABASE_SSL_CA=

# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_CONNECT_TIMEOUT_MS=5000

# Used by docker-compose.yml for the optional local-db profile only; keep it equal to the password in DATABASE_URL.
# DB_PASSWORD=

# ═════════════════════════════════════════════════════════════════════════════
# REDIS (optional: only needed when you run more than one API container)
# ═════════════════════════════════════════════════════════════════════════════

# Shared rate-limit counters. Without it each container counts on its own, which is correct for one
# container and weaker for several. If Redis goes down the API keeps working on in-memory counters.
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
# REDIS_PASSWORD=

# ═════════════════════════════════════════════════════════════════════════════
# SIGN-IN AND REGISTRATION
# ═════════════════════════════════════════════════════════════════════════════

# open   anyone who can reach the API can create a learner account
# code   learners need REGISTRATION_CODE (give it out at the site or in the trainer's briefing)
# closed nobody can create a learner account by themselves; an administrator adds learners in the console
#        (Learners > Add a learner: a one-time password, and the learner accepts the privacy notice at first sign-in).
REGISTRATION_MODE=code
# Required while REGISTRATION_MODE=code in production: at least 6 characters. (A development server without it
# opens registration instead and says so at start-up.)
REGISTRATION_CODE=

# Rotating JWT_SECRET without signing everyone out: put the old secret here (comma separated) for
# one access-token lifetime, then remove it.
# JWT_SECRET_PREVIOUS=

# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# SESSION_MAX_DAYS=90
# AUTH_CACHE_TTL_MS=10000

# How long a one-time password from the console (new account, "Reset password") or create-admin works
# before it must be issued again. Unused ones written on paper or sent by message stop being a way in.
# TEMP_PASSWORD_TTL_HOURS=72

# ═════════════════════════════════════════════════════════════════════════════
# LEGAL AND SUPPORT (shown in the app; have them reviewed: docs/DPDP-CHECKLIST.md)
# ═════════════════════════════════════════════════════════════════════════════

# The version of the privacy notice and terms learners accept. Raise it (2, 2027-01, ...) when the notice
# changes: every learner is then asked to accept the new one in the app before they continue, and each
# acceptance is recorded (account and audit log). Accounts an administrator created, and accounts from before
# consent was recorded, are asked at their first sign-in. Staff accounts are not asked.
# CONSENT_VERSION=1
# PRIVACY_POLICY_URL=https://example.org/privacy
# TERMS_URL=https://example.org/terms
# SUPPORT_EMAIL=training@example.org
# SUPPORT_PHONE=+911234567890

# ═════════════════════════════════════════════════════════════════════════════
# E-MAIL (password-reset codes). Optional: without it, trainers issue temporary passwords.
# ═════════════════════════════════════════════════════════════════════════════

# Plain SMTP, so any provider works (Brevo, Resend, Amazon SES, Mailgun, Gmail, ...).
# All four of host, port, user and password, or none of them.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=FastSewa <no-reply@example.org>
# On every port but 465 the connection must upgrade to TLS (STARTTLS) or nothing is sent, so the SMTP password
# and the reset codes never travel in plain text. Only a relay on this machine (localhost) is exempt by default.
# SMTP_REQUIRE_TLS=true

# ═════════════════════════════════════════════════════════════════════════════
# MEDIA (uploaded videos and images). Optional: YouTube links work without any of this.
# ═════════════════════════════════════════════════════════════════════════════

# s3 | cloudinary | local | none. Default: s3 if AWS_S3_BUCKET is set, else cloudinary if its keys are set,
# else none in production (local in development).
# MEDIA_PROVIDER=s3

# Amazon S3 or an S3-compatible store (Cloudflare R2, Backblaze B2, MinIO, DigitalOcean Spaces).
# The browser uploads straight to the bucket with a short-lived signed URL, so the bucket needs a CORS
# rule that allows PUT from the API's public address (DEPLOYMENT.md, "Media storage").
# AWS_S3_BUCKET=
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# The public address the stored files are served from (a CDN or public bucket URL). Required with S3_ENDPOINT.
# MEDIA_PUBLIC_BASE_URL=https://media.example.org
# Extra hosts that lessons may link to besides YouTube and the provider above (comma separated).
# MEDIA_ALLOWED_HOSTS=

# Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Local disk (one server only; the directory must be a persistent, backed-up volume).
# docker-compose.yml already points UPLOADS_DIR at its uploads volume.
# UPLOADS_DIR=/data/uploads

# MAX_IMAGE_MB=10
# MAX_VIDEO_MB=500

# ═════════════════════════════════════════════════════════════════════════════
# PUSH NOTIFICATIONS (optional)
# ═════════════════════════════════════════════════════════════════════════════

# Expo push access token (expo.dev > Account settings > Access tokens), if you enabled "enhanced security".
# EXPO_ACCESS_TOKEN=

# ═════════════════════════════════════════════════════════════════════════════
# RATE LIMITS SHARED BY A WHOLE SITE (optional)
# ═════════════════════════════════════════════════════════════════════════════

# Most limits count per person or per username. These four count per network address, and a whole site
# (one Wi-Fi, one mobile-carrier NAT address) shares them. The defaults fit a few hundred phones behind one
# address; raise them for a bigger site. nginx's flood guard (nginx/fastsewa.conf) still caps one address.
#
# Sign-in screens, registration and the app's settings, per minute:
# RATE_LIMIT_ANON_PER_MIN=600
# New accounts per hour (a crew registering together after the briefing):
# RATE_LIMIT_REGISTER_PER_HOUR=200
# Session refreshes per 15 minutes (each phone does about one):
# RATE_LIMIT_REFRESH_PER_15MIN=3000
# Wrong passwords per 15 minutes, across all usernames:
# RATE_LIMIT_LOGIN_FAILURES_PER_15MIN=60

# ═════════════════════════════════════════════════════════════════════════════
# DEVELOPMENT AND TESTS ONLY (the API refuses these in production)
# ═════════════════════════════════════════════════════════════════════════════

# Tests wipe their database: the name must contain "test". Never point this at real data.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/fastsewa_test

# Not allowed in production: switches all rate limits off.
# RATE_LIMIT_DISABLED=false

# `npm run seed` creates sample accounts and courses; it refuses production unless this is set on purpose.
# SEED_PASSWORD gives all sample accounts one known password for a local demo; SEED_VIDEO_URL adds a YouTube lesson.
# ALLOW_DEMO_SEED=false
# SEED_PASSWORD=
# SEED_VIDEO_URL=

# ═════════════════════════════════════════════════════════════════════════════
# MOBILE APP BUILD (read by Expo when the app is built; the API ignores it)
# ═════════════════════════════════════════════════════════════════════════════

# Development: leave it unset and the app finds the API on your computer by itself.
# Store builds take their address from eas.json (build.<profile>.env), not from this file;
# `npm run check:release` refuses a placeholder or http:// address.
# EXPO_PUBLIC_API_URL=https://api.example.com
