# ─────────────────────────────────────────────────────────────
#  FastSewa Training — Environment Variables
#  Copy to .env and fill in real values. Never commit .env!
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development           # development | production
PORT=5000

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://fastsewa:yourpassword@localhost:5432/fastsewa_db
DB_PASSWORD=yourpassword       # used by docker-compose

# ── Auth ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_minimum_32_chars_random_string_here

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:8081,https://yourdomain.com

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=yourredispassword

# ── Cloudinary (optional — for video/image uploads) ───────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AWS S3 (alternative to Cloudinary) ───────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=fastsewa-media
AWS_REGION=ap-south-1

# ── Mobile app (Expo) ─────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:5000
# Production:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com
