# ─────────────────────────────────────────────────────────────
#  FastSewa Training — Environment Variables
#  Copy to .env and fill in real values. Never commit .env!
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development           # development | production
PORT=5000

# ── Database ──────────────────────────────────────────────────
# Production: use a managed Postgres provider (recommended: Neon —
# neon.tech, free tier, no code changes needed). Create a project there,
# then paste its connection string here as-is (it already includes
# sslmode=require). Any managed Postgres works the same way — Supabase,
# Render Postgres, Railway — just swap the URL.
#   DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Local dev only (self-hosted, e.g. via docker-compose): 
DATABASE_URL=postgresql://fastsewa:yourpassword@localhost:5432/fastsewa_db
DB_PASSWORD=yourpassword       # used by docker-compose (local/self-hosted db only)

# ── Auth ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_minimum_32_chars_random_string_here

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:8081,https://yourdomain.com

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=yourredispassword

# ── Email / password reset (optional but recommended) ─────────
# Plain SMTP — works with any provider (Resend, Brevo, AWS SES, Mailgun,
# Gmail, ...). Without these set, forgot-password still works in dev: the
# reset code is logged to the server console instead of emailed.
# Free-tier options that work well here: Resend (resend.com) or Brevo
# (brevo.com, 300 emails/day free via SMTP relay).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FastSewa <no-reply@yourdomain.com>

# ── Cloudinary (optional — for video/image uploads) ───────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AWS S3 (alternative to Cloudinary) ───────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=fastsewa-media
AWS_REGION=ap-south-1

# ── Mobile app (Expo) ─────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:5000
# Production:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com
